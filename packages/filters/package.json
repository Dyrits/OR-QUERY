{
  "author": "",
  "description": "Unified query filtering across Prisma, Drizzle, TypeORM, and Supabase",
  "devDependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "drizzle-orm": "^0.45.1",
    "typeorm": "^1.1.1",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./drizzle": {
      "import": "./dist/drizzle/index.js",
      "types": "./dist/drizzle/index.d.ts"
    },
    "./prisma": {
      "import": "./dist/prisma/index.js",
      "types": "./dist/prisma/index.d.ts"
    },
    "./supabase": {
      "import": "./dist/supabase/index.js",
      "types": "./dist/supabase/index.d.ts"
    },
    "./typeorm": {
      "import": "./dist/typeorm/index.js",
      "types": "./dist/typeorm/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ormx",
    "query",
    "filter",
    "prisma",
    "drizzle",
    "supabase",
    "typeorm",
    "orm",
    "database"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "name": "@ormx/filters",
  "peerDependencies": {
    "drizzle-orm": ">=0.30.0",
    "typeorm": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "packages/filters",
    "type": "git",
    "url": "git+https://github.com/Dyrits/ORMX.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.3.0"
}
