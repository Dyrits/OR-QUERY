{
  "author": "",
  "dependencies": {
    "@ormx/filters": "workspace:^"
  },
  "description": "Unified datasource abstraction for Drizzle, Prisma and Supabase with transaction support",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@prisma/client": "^7.10.0",
    "@supabase/supabase-js": "^2.49.4",
    "drizzle-orm": "^0.45.1",
    "pglite-prisma-adapter": "^0.7.2",
    "prisma": "^7.10.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ormx",
    "datasource",
    "repository",
    "drizzle",
    "prisma",
    "supabase",
    "database",
    "orm"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "name": "@ormx/datasources",
  "peerDependencies": {
    "@prisma/client": ">=6.2.0",
    "drizzle-orm": ">=0.30.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "packages/datasources",
    "type": "git",
    "url": "https://github.com/Dyrits/ORMX.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "prisma generate",
    "prepublishOnly": "bun run build",
    "test": "bun run generate && vitest run",
    "test:watch": "vitest",
    "typecheck": "bun run generate && tsc --noEmit"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.2.0"
}
